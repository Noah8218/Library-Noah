<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageDescription>UI-independent height-map, full-XYZ geometry, matching, and 3D inspection contracts and algorithms for OpenVisionLab.</PackageDescription>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="" Link="README.md" />
    <None Include="..\docs\three-d-inspection.md" Pack="true" PackagePath="docs" Link="docs\three-d-inspection.md" />
  </ItemGroup>

</Project>
