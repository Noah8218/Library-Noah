<Project>
  <ItemGroup>
    <OpenVisionLabCoreNativeDlls Include="$(MSBuildThisFileDirectory)..\runtimes\win-x64\native\OpenCvSharpExtern.dll" />
  </ItemGroup>

  <Target Name="CopyOpenVisionLabCoreNativeDlls" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(TargetDir)' != ''">
    <Copy SourceFiles="@(OpenVisionLabCoreNativeDlls)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('%(OpenVisionLabCoreNativeDlls.FullPath)')" />
  </Target>
</Project>
