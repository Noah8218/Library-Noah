<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <PackageDescription>Deterministic OpenCvSharp-based 2D inspection tools and result contracts for OpenVisionLab.</PackageDescription>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="OpenCvSharp">
      <HintPath>..\OpenVisionLab.Core\DLL\OpenCvSharp.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="OpenCvSharp.Blob">
      <HintPath>..\OpenVisionLab.Core\DLL\OpenCvSharp.Blob.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenVisionLab.Core\OpenVisionLab.Core.csproj" />
  </ItemGroup>

</Project>
